# ===============================================
# AGROCONNECT - BACKEND ENVIRONMENT CONFIGURATION
# ===============================================

# Server settings
PORT=8000
HOST="0.0.0.0"
ENVIRONMENT="development"

# MongoDB Database Connection
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/agroconnect?retryWrites=true&w=majority"
DATABASE_NAME="agroconnect_db"

# JWT Security
JWT_SECRET="super-secret-jwt-key-change-in-production-agroconnect"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 Days

# Gemini AI API Key (For AI Farmer Assistant)
# Required for real-time agronomic reasoning and marketplace synthesis
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://agroconnect.vercel.app"]
